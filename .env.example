# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# mock | split | stable | elevenlabs
# Use `split` for confirmed production routing (ElevenLabs text + Stable Audio a2a)
MUSIC_PROVIDER=mock

# Supabase (optional — app falls back to local mock store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Music providers (required when MUSIC_PROVIDER=split|stable|elevenlabs)
STABILITY_API_KEY=
ELEVENLABS_API_KEY=

# Credits
DEFAULT_CREDITS=50
